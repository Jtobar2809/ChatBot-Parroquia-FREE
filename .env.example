# ============================================
# CONFIGURACION DEL CHATBOT DE LA PARROQUIA
# ============================================

# Puerto en el que correra el servidor Express
PORT=3000

# Entorno de ejecucion (development | production)
NODE_ENV=development

# ============================================
# SUPABASE
# ============================================
# Obten estos valores desde tu panel de Supabase:
# Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key-aqui

# ============================================
# WHATSAPP / BAILEYS
# ============================================
# Carpeta donde se guarda la sesion de WhatsApp
# (asi no tienes que escanear el QR cada vez)
SESSION_FOLDER=auth_session

# Nombre que aparecera en el dispositivo enlazado
BOT_NAME=Parroquia Bot
